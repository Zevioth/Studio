
-- INFINITE TERRAIN V3
-- Place in ServerScriptService
-- Previous generator must be disabled.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Terrain = Workspace.Terrain

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local SEED = 58321

local STEP_SIZE = 16
local RESOLUTION = 4

local LOAD_RADIUS = 6
local WATER_LEVEL = 24

local MIN_Y = -64
local MAX_Y = 192

local UPDATE_INTERVAL = 0.15
local WORLD_CHUNK_SIZE = 64

local STEPS_PER_CHUNK =
    WORLD_CHUNK_SIZE / STEP_SIZE

--------------------------------------------------
-- TERRAIN APPEARANCE
--------------------------------------------------

Terrain.Decoration = true

Terrain:SetMaterialColor(
    Enum.Material.Grass,
    Color3.fromRGB(29, 77, 38)
)

Terrain:SetMaterialColor(
    Enum.Material.Ground,
    Color3.fromRGB(43, 65, 37)
)

Terrain:SetMaterialColor(
    Enum.Material.Mud,
    Color3.fromRGB(65, 54, 39)
)

Terrain.WaterColor = Color3.fromRGB(48, 94, 110)

--------------------------------------------------
-- ASSET LOADING
-- Assets are OPTIONAL. Missing assets will
-- never stop terrain generation.
--------------------------------------------------

local ChunkFolder =
    ReplicatedStorage:FindFirstChild("Chunk")

local NatureFolder =
    ChunkFolder and ChunkFolder:FindFirstChild("Nature")

local TreeTemplates = {}

if NatureFolder then

    for _, name in ipairs({"Tree1", "Tree2", "Tree3"}) do

        local object = NatureFolder:FindFirstChild(name)

        if object and (
            object:IsA("Model")
            or object:IsA("BasePart")
        ) then

            table.insert(TreeTemplates, object)

        else

            warn("Missing tree template:", name)

        end

    end

else

    warn("Nature folder missing. Terrain will still generate.")

end

--------------------------------------------------
-- HOUSE TEMPLATE
--------------------------------------------------

local function FindPath(root, names)

    local current = root

    for _, name in ipairs(names) do

        if not current then
            return nil
        end

        current = current:FindFirstChild(name)

    end

    return current

end

local HouseRoot =
    FindPath(ReplicatedStorage, {
        "Structures", "Chunk", "Structures", "House"
    })

if not HouseRoot then

    HouseRoot =
        FindPath(ReplicatedStorage, {
            "Chunk", "Structures", "House"
        })

end

local HouseTemplate = nil
local HouseChanceValue = nil

if HouseRoot then

    if HouseRoot:IsA("Model")
        or HouseRoot:IsA("BasePart") then

        HouseTemplate = HouseRoot

    else

        HouseTemplate =
            HouseRoot:FindFirstChildWhichIsA("Model", true)
            or HouseRoot:FindFirstChildWhichIsA("BasePart", true)

    end

    HouseChanceValue =
        HouseRoot:FindFirstChild("Chance", true)
        or HouseRoot:FindFirstChild("IntValue", true)

    if not HouseChanceValue then

        for _, object in ipairs(HouseRoot:GetDescendants()) do

            if object:IsA("IntValue") then
                HouseChanceValue = object
                break
            end

        end

    end

end

if not HouseTemplate then
    warn("House model missing. Houses disabled.")
end

--------------------------------------------------
-- GENERATED OBJECTS
--------------------------------------------------

local function GetFolder(name)

    local folder = Workspace:FindFirstChild(name)

    if not folder then

        folder = Instance.new("Folder")
        folder.Name = name
        folder.Parent = Workspace

    end

    return folder

end

local NatureOutput = GetFolder("GeneratedNature")
local StructureOutput = GetFolder("GeneratedStructures")

--------------------------------------------------
-- WORLD DATA
--------------------------------------------------

local GeneratedTiles = {}
local QueuedTiles = {}

local PlayerCenters = {}
local HouseAttempts = {}

local function Key(x, z)
    return tostring(x) .. "," .. tostring(z)
end

local function MakeRNG(x, z, salt)

    local seed =
        SEED
        + x * 73856093
        + z * 19349663
        + salt * 83492791

    seed = math.floor(math.abs(seed) % 2147483646) + 1

    return Random.new(seed)

end

--------------------------------------------------
-- PROCEDURAL HEIGHT
--------------------------------------------------

local function GetTerrainData(x, z)

    local continent = math.noise(
        x / 850,
        z / 850,
        SEED * 0.0001
    )

    local land = math.clamp(
        (continent + 0.12) / 0.36,
        0,
        1
    )

    -- Guaranteed starting island near origin.
    local distance = math.sqrt(x * x + z * z)

    local startingIsland = math.clamp(
        1 - distance / 260,
        0,
        1
    )

    land = math.max(land, startingIsland)

    local hills = math.noise(
        x / 175,
        z / 175,
        SEED * 0.0002
    )

    local detail = math.noise(
        x / 55,
        z / 55,
        SEED * 0.0003
    )

    local ridge = 1 - math.abs(math.noise(
        x / 450,
        z / 450,
        SEED * 0.0004
    ))

    local forestNoise = math.noise(
        x / 500,
        z / 500,
        SEED * 0.0005
    )

    local height =
        8
        + land * 46
        + hills * 9
        + detail * 2

    local biome

    if land < 0.35 then

        biome = "Ocean"

    elseif land < 0.62 or height < WATER_LEVEL + 5 then

        biome = "Beach"

    elseif ridge > 0.85 then

        local strength = (ridge - 0.85) / 0.15

        height += strength ^ 2 * 85

        biome = "Mountains"

    elseif forestNoise > 0.25 then

        biome = "BigForest"

    elseif forestNoise > -0.20 then

        biome = "Forest"

    else

        biome = "Plains"

    end

    -- Occasional inland lakes.
    if land > 0.65
        and biome ~= "Mountains"
        and math.noise(
            x / 320,
            z / 320,
            SEED * 0.0008
        ) > 0.86 then

        height = WATER_LEVEL - 8
        biome = "Lake"

    end

    return math.clamp(height, MIN_Y, MAX_Y - 8), biome

end

--------------------------------------------------
-- OBJECT PLACEMENT
--------------------------------------------------

local function PlaceObject(template, parent, x, y, z, rng)

    if not template then
        return
    end

    local clone = template:Clone()

    for _, object in ipairs(clone:GetDescendants()) do

        if object:IsA("BasePart") then
            object.Anchored = true
        end

    end

    if clone:IsA("BasePart") then
        clone.Anchored = true
    end

    clone:PivotTo(
        CFrame.new(x, y, z)
        * CFrame.Angles(
            0,
            rng:NextNumber(0, math.pi * 2),
            0
        )
    )

    clone.Parent = parent

    return clone

end

--------------------------------------------------
-- TREE GENERATION
--------------------------------------------------

local function GenerateTrees(tileX, tileZ)

    if #TreeTemplates == 0 then
        return
    end

    local rng = MakeRNG(tileX, tileZ, 100)

    local originX = tileX * STEP_SIZE
    local originZ = tileZ * STEP_SIZE

    local _, centerBiome = GetTerrainData(
        originX + 8,
        originZ + 8
    )

    local count = 0

    if centerBiome == "BigForest" then

        count = rng:NextInteger(2, 4)

    elseif centerBiome == "Forest" then

        count = rng:NextInteger(1, 2)

    elseif centerBiome == "Plains" then

        if rng:NextNumber() < 0.08 then
            count = 1
        end

    end

    local positions = {}

    for i = 1, count do

        for attempt = 1, 12 do

            local x = originX + rng:NextNumber(3, 13)
            local z = originZ + rng:NextNumber(3, 13)

            local height, biome = GetTerrainData(x, z)

            local h1 = GetTerrainData(x + 4, z)
            local h2 = GetTerrainData(x, z + 4)

            local validBiome =
                biome == "Forest"
                or biome == "BigForest"

            local flat =
                math.abs(height - h1) < 5
                and math.abs(height - h2) < 5

            local separated = true

            for _, position in ipairs(positions) do

                if (Vector3.new(x, 0, z) - position).Magnitude < 7 then

                    separated = false
                    break

                end

            end

            if validBiome and flat and separated then

                local template = TreeTemplates[
                    rng:NextInteger(1, #TreeTemplates)
                ]

                PlaceObject(
                    template,
                    NatureOutput,
                    x,
                    height,
                    z,
                    rng
                )

                table.insert(
                    positions,
                    Vector3.new(x, 0, z)
                )

                break

            end

        end

    end

end

--------------------------------------------------
-- HOUSE GENERATION
--------------------------------------------------

local function GenerateHouse(chunkX, chunkZ, tileX, tileZ)

    if not HouseTemplate or not HouseChanceValue then
        return
    end

    local chance = 0

    if HouseChanceValue:IsA("IntValue") then
        chance = math.clamp(HouseChanceValue.Value, 0, 100)
    end

    if chance <= 0 then
        return
    end

    local chunkKey = Key(chunkX, chunkZ)

    if HouseAttempts[chunkKey] then
        return
    end

    HouseAttempts[chunkKey] = true

    local rng = MakeRNG(chunkX, chunkZ, 200)

    if rng:NextInteger(1, 100) > chance then
        return
    end

    local originX = tileX * STEP_SIZE
    local originZ = tileZ * STEP_SIZE

    for attempt = 1, 20 do

        local x = originX + rng:NextNumber(2, 14)
        local z = originZ + rng:NextNumber(2, 14)

        local height, biome = GetTerrainData(x, z)

        local h1 = GetTerrainData(x + 5, z)
        local h2 = GetTerrainData(x, z + 5)

        local valid =
            biome == "Plains"
            or biome == "Forest"

        local flat =
            math.abs(height - h1) < 5
            and math.abs(height - h2) < 5

        if valid and flat and height > WATER_LEVEL + 5 then

            PlaceObject(
                HouseTemplate,
                StructureOutput,
                x,
                height,
                z,
                rng
            )

            print("House generated:", chunkKey)

            return

        end

    end

end

--------------------------------------------------
-- TERRAIN STEP
--------------------------------------------------

local function GenerateTile(tileX, tileZ)

    local originX = tileX * STEP_SIZE
    local originZ = tileZ * STEP_SIZE

    local region = Region3.new(
        Vector3.new(originX, MIN_Y, originZ),
        Vector3.new(
            originX + STEP_SIZE,
            MAX_Y,
            originZ + STEP_SIZE
        )
    ):ExpandToGrid(RESOLUTION)

    -- Always match array dimensions to the actual region.
    local size = region.Size / RESOLUTION

    local min = region.CFrame.Position - region.Size / 2

    local nx, ny, nz = size.X, size.Y, size.Z

    local solidMaterials = {}
    local solidOccupancies = {}
    local liquidOccupancies = {}

    -- Cache height and biome for each horizontal column.
    local heights = {}
    local biomes = {}

    for x = 1, nx do

        heights[x] = {}
        biomes[x] = {}

        for z = 1, nz do

            local worldX = min.X + (x - 0.5) * RESOLUTION
            local worldZ = min.Z + (z - 0.5) * RESOLUTION

            local height, biome = GetTerrainData(worldX, worldZ)

            heights[x][z] = height
            biomes[x][z] = biome

        end

    end

    -- Allocate three voxel channels.
    for x = 1, nx do

        solidMaterials[x] = {}
        solidOccupancies[x] = {}
        liquidOccupancies[x] = {}

        for y = 1, ny do

            solidMaterials[x][y] = {}
            solidOccupancies[x][y] = {}
            liquidOccupancies[x][y] = {}

            local worldY = min.Y + (y - 0.5) * RESOLUTION

            for z = 1, nz do

                local height = heights[x][z]
                local biome = biomes[x][z]

                local material = Enum.Material.Air
                local solid = 0
                local water = 0

                if worldY <= height then

                    solid = 1

                    local depth = height - worldY

                    if biome == "Ocean"
                        or biome == "Beach"
                        or biome == "Lake" then

                        if depth <= 4 then
                            material = Enum.Material.Sand
                        elseif depth <= 20 then
                            material = Enum.Material.Mud
                        else
                            material = Enum.Material.Rock
                        end

                    else

                        if depth <= 4 then
                            material = Enum.Material.Grass
                        elseif depth <= 20 then
                            material = Enum.Material.Mud
                        else
                            material = Enum.Material.Rock
                        end

                    end

                elseif worldY <= WATER_LEVEL then

                    water = 1

                end

                solidMaterials[x][y][z] = material
                solidOccupancies[x][y][z] = solid
                liquidOccupancies[x][y][z] = water

            end

        end

    end

    -- WRITE TERRAIN AND WATER
    Terrain:WriteVoxelChannels(
        region,
        RESOLUTION,
        {
            SolidMaterial = solidMaterials,
            SolidOccupancy = solidOccupancies,
            LiquidOccupancy = liquidOccupancies
        }
    )

    local key = Key(tileX, tileZ)

    GeneratedTiles[key] = true

    -- Generate nature after terrain.
    GenerateTrees(tileX, tileZ)

    -- One house chance per 64x64 area.
    local chunkX = math.floor(tileX / STEPS_PER_CHUNK)
    local chunkZ = math.floor(tileZ / STEPS_PER_CHUNK)

    local localX = tileX - chunkX * STEPS_PER_CHUNK
    local localZ = tileZ - chunkZ * STEPS_PER_CHUNK

    if localX == 2 and localZ == 2 then

        GenerateHouse(
            chunkX,
            chunkZ,
            tileX,
            tileZ
        )

    end

end

--------------------------------------------------
-- PLAYER DISTANCE
--------------------------------------------------

local function GetNearestDistance(x, z)

    local nearest = math.huge

    for _, center in pairs(PlayerCenters) do

        local dx = x - center.x
        local dz = z - center.z

        local distance = dx * dx + dz * dz

        if distance < nearest then
            nearest = distance
        end

    end

    return nearest

end

--------------------------------------------------
-- QUEUE
--------------------------------------------------

local function QueueTile(x, z)

    local key = Key(x, z)

    if GeneratedTiles[key] or QueuedTiles[key] then
        return
    end

    QueuedTiles[key] = {
        x = x,
        z = z
    }

end

local function QueueAroundPlayer(centerX, centerZ)

    for x = -LOAD_RADIUS, LOAD_RADIUS do

        for z = -LOAD_RADIUS, LOAD_RADIUS do

            if x * x + z * z <= LOAD_RADIUS * LOAD_RADIUS then

                QueueTile(
                    centerX + x,
                    centerZ + z
                )

            end

        end

    end

end

--------------------------------------------------
-- PRIORITY: NEAREST TILE FIRST
--------------------------------------------------

local function GetNextTile()

    local bestKey = nil
    local bestTile = nil
    local bestDistance = math.huge

    for key, tile in pairs(QueuedTiles) do

        local distance = GetNearestDistance(
            tile.x,
            tile.z
        )

        if distance > LOAD_RADIUS * LOAD_RADIUS then

            QueuedTiles[key] = nil

        elseif distance < bestDistance then

            bestKey = key
            bestTile = tile
            bestDistance = distance

        end

    end

    if bestKey then

        QueuedTiles[bestKey] = nil

        return bestTile

    end

    return nil

end

--------------------------------------------------
-- SINGLE TERRAIN WORKER
--------------------------------------------------

local function Worker()

    while true do

        local tile = GetNextTile()

        if tile then

            local success, err = pcall(
                GenerateTile,
                tile.x,
                tile.z
            )

            if success then

                print(
                    "[Terrain] Generated:",
                    Key(tile.x, tile.z)
                )

            else

                warn(
                    "[Terrain] FAILED:",
                    Key(tile.x, tile.z),
                    err
                )

            end

            task.wait(0.02)

        else

            task.wait(0.05)

        end

    end

end

task.spawn(Worker)

--------------------------------------------------
-- PLAYER SPAWNING
--------------------------------------------------

local function OnCharacterAdded(player, character)

    task.spawn(function()

        local root = character:WaitForChild(
            "HumanoidRootPart",
            10
        )

        if not root then
            return
        end

        local x = root.Position.X
        local z = root.Position.Z

        local tileX = math.floor(x / STEP_SIZE)
        local tileZ = math.floor(z / STEP_SIZE)

        local key = Key(tileX, tileZ)

        -- Wait until the spawn tile is generated.
        for i = 1, 200 do

            if GeneratedTiles[key] then
                break
            end

            if not character.Parent then
                return
            end

            task.wait(0.1)

        end

        if not root.Parent or not GeneratedTiles[key] then
            return
        end

        local height = GetTerrainData(x, z)

        root.CFrame = CFrame.new(
            x,
            height + 7,
            z
        )

    end)

end

local function SetupPlayer(player)

    player.CharacterAdded:Connect(function(character)

        OnCharacterAdded(player, character)

    end)

    if player.Character then

        OnCharacterAdded(
            player,
            player.Character
        )

    end

end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(player)

    PlayerCenters[player] = nil

end)

for _, player in ipairs(Players:GetPlayers()) do

    SetupPlayer(player)

end

--------------------------------------------------
-- MOVEMENT DETECTION
--------------------------------------------------

print("[Terrain] Infinite generator started!")

while true do

    for _, player in ipairs(Players:GetPlayers()) do

        local character = player.Character

        local root = character
            and character:FindFirstChild("HumanoidRootPart")

        if root then

            local tileX = math.floor(
                root.Position.X / STEP_SIZE
            )

            local tileZ = math.floor(
                root.Position.Z / STEP_SIZE
            )

            local previous = PlayerCenters[player]

            if not previous
                or previous.x ~= tileX
                or previous.z ~= tileZ then

                PlayerCenters[player] = {
                    x = tileX,
                    z = tileZ
                }

                QueueAroundPlayer(tileX, tileZ)

            end

        end

    end

    task.wait(UPDATE_INTERVAL)

end
