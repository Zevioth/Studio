local viewportConnection

local function updateLayout()
    local camera = Workspace.CurrentCamera
    if not camera then
        return
    end

    local viewport = camera.ViewportSize
    local width = viewport.X
    local height = viewport.Y

    isMobile = width < CONFIG.MobileBreakpoint

    local scale
    if isMobile then
        scale = math.clamp(math.min(width / 390, height / 700), 0.76, 1)
    else
        scale = math.clamp(math.min(width / 1280, height / 800), 0.78, 1.08)
    end

    AppScale.Scale = scale
    App.Size = UDim2.new(1 / scale, 0, 1 / scale, 0)

    Sidebar.Visible = not isMobile
    MobileNavigation.Visible = isMobile
    UserPill.Visible = not isMobile

    if isMobile then
        Main.Position = UDim2.new(0, 0, 0, 0)
        Main.Size = UDim2.fromScale(1, 1)

        Header.Size = UDim2.new(1, 0, 0, 68)
        Content.Position = UDim2.new(0, 0, 0, 68)
        Content.Size = UDim2.new(1, 0, 1, -138)

        ContentPadding.PaddingLeft = UDim.new(0, 14)
        ContentPadding.PaddingRight = UDim.new(0, 14)
        ContentPadding.PaddingTop = UDim.new(0, 16)
