    "rbxassetid://132113571207729",
}

--// TEXTURES

local FACE_TEXTURES = {
    [Enum.NormalId.Top] =
        "rbxassetid://9267183930",

    [Enum.NormalId.Bottom] =
        "rbxassetid://9267089500",

    [Enum.NormalId.Front] =
        "rbxassetid://9267155972",

    [Enum.NormalId.Back] =
        "rbxassetid://9267155972",

    [Enum.NormalId.Left] =
        "rbxassetid://9267155972",

    [Enum.NormalId.Right] =
        "rbxassetid://9267155972",
}

local FACE_NAMES = {
    [Enum.NormalId.Top] = "Top",
    [Enum.NormalId.Bottom] = "Bottom",
