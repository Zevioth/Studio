    limitWrap.LayoutOrder = 6

    local tagArea = create("Frame", form, {
        Size = UDim2.new(1, 0, 0, 72),
        BackgroundTransparency = 1,
        LayoutOrder = 7,
    })

    local tagTitle = makeText(tagArea, "WORLD TAGS (OPTIONAL)", 10, COLORS.Navy, Enum.Font.GothamBold)
    tagTitle.Size = UDim2.new(1, 0, 0, 17)

    local tagScroll = create("ScrollingFrame", tagArea, {
        Position = UDim2.new(0, 0, 0, 23),
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.X,
        ScrollingDirection = Enum.ScrollingDirection.X,
    })

    local tagLayout = create("UIListLayout", tagScroll, {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 7),
        VerticalAlignment = Enum.VerticalAlignment.Center,
    })

    local selectedTags = {}
    for _, tag in ipairs(TAG_OPTIONS) do
        local tagButton = create("TextButton", tagScroll, {
            Size = UDim2.fromOffset(88, 31),
            BackgroundColor3 = COLORS.SurfaceAlt,
            BorderSizePixel = 0,
            Text = tag,
            TextColor3 = COLORS.Muted,
            TextSize = 9,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = false,
        })
        addCorner(tagButton, 8)

        tagButton.Activated:Connect(function()
            if selectedTags[tag] then
                selectedTags[tag] = nil
                tagButton.BackgroundColor3 = COLORS.SurfaceAlt
                tagButton.TextColor3 = COLORS.Muted
            else
                selectedTags[tag] = true
                tagButton.BackgroundColor3 = COLORS.BlueLight
                tagButton.TextColor3 = COLORS.BlueDark
            end
        end)
    end

    local createButton
    createButton = makeButton(form, "Create World", COLORS.Green, UDim2.new(1, 0, 0, 42), function()
        local name = trimText(nameInput.Text, CONFIG.MaxWorldName)
        local description = trimText(descInput.Text, CONFIG.MaxDescription)
        local maxPlayers = tonumber(limitInput.Text)

        if name == "" then
            notify("Please enter a world name.")
            return
        end

        if not maxPlayers or maxPlayers % 1 ~= 0 or maxPlayers < 1 or maxPlayers > CONFIG.MaxPlayers then
            notify("Player limit must be between 1 and 20.")
            return
        end

        local tags = {}
        for tag, enabled in pairs(selectedTags) do
            if enabled then
                table.insert(tags, tag)
            end
        end
        table.sort(tags)

        createButton.Text = "Creating..."
        createButton.Active = false
        createButton.AutoButtonColor = false

        task.spawn(function()
            local response, err = callBackend("CreateWorld", {
                name = name,
                description = description,
                gameType = selectedType,
                visibility = selectedVisibility,
                maxPlayers = maxPlayers,
                tags = tags,
            })

            if not response then
                notify(err or "Could not contact backend.")
            elseif not response.ok then
                notify(response.message or "World creation failed.")
            else
                notify(response.message or "World created. Joining...")
            end

            if createButton.Parent then
                createButton.Text = "Create World"
                createButton.Active = true
            end
        end)
    end)
    createButton.LayoutOrder = 8

    local note = makeText(form, "Your world settings are validated and saved by the server. Teleporting begins after creation.", 9, COLORS.Muted)
    note.Size = UDim2.new(1, 0, 0, 34)
    note.LayoutOrder = 9
    note.TextYAlignment = Enum.TextYAlignment.Top
end

