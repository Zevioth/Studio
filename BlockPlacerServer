local function makeSelect(parent, labelText, options, defaultValue, onChanged)
    local wrapper = create("Frame", parent, {
        Size = UDim2.new(1, 0, 0, 63),
        BackgroundTransparency = 1,
    })

    local label = makeText(wrapper, labelText, 10, COLORS.Navy, Enum.Font.GothamBold)
    label.Size = UDim2.new(1, 0, 0, 17)

    local currentIndex = table.find(options, defaultValue) or 1
    local button = create("TextButton", wrapper, {
        Position = UDim2.new(0, 0, 0, 23),
        Size = UDim2.new(1, 0, 0, 37),
        BackgroundColor3 = COLORS.SurfaceAlt,
        BorderSizePixel = 0,
        Text = "  " .. options[currentIndex] .. "     ▾",
        TextColor3 = COLORS.Text,
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
    })
    addCorner(button, 9)

    button.Activated:Connect(function()
        currentIndex = currentIndex % #options + 1
        local value = options[currentIndex]
        button.Text = "  " .. value .. "     ▾"
        if onChanged then
            onChanged(value)
        end
    end)

    return wrapper
end

