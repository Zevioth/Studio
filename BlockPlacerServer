local PLACE_SOUND_IDS = {
    "rbxassetid://137891923918460",
    "rbxassetid://137872931202432",
    "rbxassetid://137851335400766",
}

local DELETE_SOUND_IDS = {
    "rbxassetid://137782073700276",
