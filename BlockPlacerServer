local function buildBrowse()
    pageHeading("Discover Worlds", "Find a place to explore and create memories.")

    local searchCard = makeCard(Content, 64)
    local searchBox = create("TextBox", searchCard, {
        Position = UDim2.new(0, 11, 0, 10),
        Size = UDim2.new(1, -22, 0, 43),
        BackgroundColor3 = COLORS.SurfaceAlt,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = "Search public worlds...",
        TextColor3 = COLORS.Text,
        PlaceholderColor3 = COLORS.Muted,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    addCorner(searchBox, 9)
    addPadding(searchBox, 11, 9, 0, 0)

    local resultsFrame = create("Frame", Content, {
        Size = UDim2.new(1, 0, 0, 80),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    })
    local resultsLayout = create("UIListLayout", resultsFrame, {
        Padding = UDim.new(0, 12),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    local cachedWorlds = {}
    local function drawResults(query)
        for _, child in ipairs(resultsFrame:GetChildren()) do
            if child ~= resultsLayout then
                child:Destroy()
            end
        end

        query = string.lower(trimText(query, 40))
        local shown = 0

        for _, world in ipairs(cachedWorlds) do
            local name = string.lower(tostring(world.name or ""))
            local description = string.lower(tostring(world.description or ""))
            if query == "" or string.find(name, query, 1, true) or string.find(description, query, 1, true) then
                local card = create("Frame", resultsFrame, {
                    Size = UDim2.new(1, 0, 0, 126),
                    BackgroundColor3 = COLORS.White,
                    BorderSizePixel = 0,
                })
                addCorner(card, 15)
                addStroke(card, COLORS.Border, 1)
                cardText(card, tostring(world.name or "Untitled World"), UDim2.new(0, 14, 0, 9), 13, Enum.Font.GothamBold)

                local desc = makeText(card, tostring(world.description or "No description"), 9, COLORS.Muted)
                desc.Position = UDim2.new(0, 14, 0, 35)
                desc.Size = UDim2.new(1, -28, 0, 20)

                local online = world.online and (tostring(world.currentPlayers or 0) .. "/" .. tostring(world.maxPlayers or 0) .. " online") or "Offline - starts when joined"
                local meta = makeText(card, tostring(world.gameType or "Sandbox") .. "  •  " .. tostring(world.ownerName or "Unknown") .. "  •  " .. online, 9, COLORS.Muted)
                meta.Position = UDim2.new(0, 14, 0, 60)
                meta.Size = UDim2.new(1, -28, 0, 18)

                local join = makeButton(card, "Join World", COLORS.Green, UDim2.fromOffset(100, 31), function()
                    notify("Joining " .. tostring(world.name or "world") .. "...")
                    task.spawn(function()
                        local response, err = callBackend("JoinWorld", world.id)
                        if not response then
                            notify(err or "Could not contact backend.")
                        elseif not response.ok then
                            notify(response.message or "Could not join world.")
                        end
                    end)
                end)
                join.Position = UDim2.new(1, -114, 1, -42)
                join.TextSize = 10
                shown += 1
            end
        end

        if shown == 0 then
            local empty = create("Frame", resultsFrame, {
                Size = UDim2.new(1, 0, 0, 110),
                BackgroundColor3 = COLORS.White,
                BorderSizePixel = 0,
            })
            addCorner(empty, 13)
            addStroke(empty, COLORS.Border, 1)
            local label = makeText(empty, #cachedWorlds == 0 and "No public worlds yet" or "No matching worlds", 13, COLORS.Text, Enum.Font.GothamBold)
            label.Position = UDim2.new(0, 14, 0, 15)
            label.Size = UDim2.new(1, -28, 0, 23)
            local sub = makeText(empty, #cachedWorlds == 0 and "Create the first public Zeorinth world." or "Try another search term.", 10, COLORS.Muted)
            sub.Position = UDim2.new(0, 14, 0, 44)
            sub.Size = UDim2.new(1, -28, 0, 24)
        end
    end

    local loading = makeText(resultsFrame, "Loading public worlds...", 10, COLORS.Muted)
    loading.Size = UDim2.new(1, 0, 0, 30)

    searchBox:GetPropertyChangedSignal("Text"):Connect(function()
        drawResults(searchBox.Text)
    end)

    task.spawn(function()
        local response, err = callBackend("ListPublicWorlds")
        if not resultsFrame.Parent then
            return
        end

        if not response or not response.ok then
            loading.Text = response and response.message or err or "Could not load public worlds."
            return
        end

        cachedWorlds = response.worlds or {}
        drawResults(searchBox.Text)
    end)
end

