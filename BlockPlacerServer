)

if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "BlockPlacerRemote"
    remote.Parent = ReplicatedStorage
end

assert(
    remote:IsA("RemoteEvent"),
    "BlockPlacerRemote must be a RemoteEvent"
