local function create(className, parent, properties)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    object.Parent = parent
    return object
end

local function addCorner(parent, radius)
    return create("UICorner", parent, {
        CornerRadius = UDim.new(0, radius or 12),
    })
end

local function addStroke(parent, color, thickness, transparency)
    return create("UIStroke", parent, {
        Color = color or COLORS.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    })
end

local function addPadding(parent, left, right, top, bottom)
    return create("UIPadding", parent, {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
    })
end

local function makeText(parent, text, size, color, font)
    return create("TextLabel", parent, {
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = text or "",
        TextSize = size or 14,
        TextColor3 = color or COLORS.Text,
        Font = font or Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    })
end

local function makeButton(parent, text, color, size, callback)
    local button = create("TextButton", parent, {
        Size = size or UDim2.new(0, 140, 0, 40),
        BackgroundColor3 = color or COLORS.Blue,
        BorderSizePixel = 0,
        Text = text or "Button",
        TextColor3 = COLORS.White,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        TextWrapped = true,
    })
    addCorner(button, 10)

    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.14), {
            BackgroundTransparency = 0.1,
        }):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.14), {
            BackgroundTransparency = 0,
        }):Play()
    end)
    button.Activated:Connect(function()
        if callback then
            callback()
        end
    end)
    return button
end

local function makeCard(parent, height, background)
    local frame = create("Frame", parent, {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = background or COLORS.Surface,
        BorderSizePixel = 0,
    })
    addCorner(frame, 15)
    addStroke(frame, COLORS.Border, 1)
    return frame
end

local function setLabel(label, position, size)
    label.Position = position
    label.Size = size
    return label
end

local function trimText(value, maximum)
    value = tostring(value or "")
    value = string.gsub(value, "^%s*(.-)%s*$", "%1")
    if #value > maximum then
        value = string.sub(value, 1, maximum)
    end
    return value
end

