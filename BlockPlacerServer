
--==============================================================
-- ZEORINTH SANDBOX
-- GAMEPLAY WORLD LOADER v1.0.0
--==============================================================

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

--==============================================================
-- CONFIGURATION
--==============================================================

local WORLD_STORE_NAME = "ZS_Worlds_v1"

local WorldStore =
    DataStoreService:GetDataStore(WORLD_STORE_NAME)

local MAX_PLAYERS = 20

-- Disable automatic spawning until the world is loaded.

Players.CharacterAutoLoads = false

--==============================================================
-- WORLD STATE
--==============================================================

local ActiveWorld = nil
local WorldGenerated = false

--==============================================================
-- PERMISSIONS
--==============================================================

local function canJoin(player, world)
    if world.visibility == "Public" then
        return true
    end

    if world.ownerId == player.UserId then
        return true
    end

    local collaborators = world.collaborators or {}

    return collaborators[tostring(player.UserId)] ~= nil
end

--==============================================================
-- GENERATE FLAT WORLD
--==============================================================

local function generateWorld(world)
    if WorldGenerated then
        return
    end

    WorldGenerated = true

    -- Remove previous generated environment.

    local previous = workspace:FindFirstChild("ZeorinthWorld")

    if previous then
        previous:Destroy()
    end

    -- Root folder.

    local folder = Instance.new("Folder")
    folder.Name = "ZeorinthWorld"
    folder.Parent = workspace

    -- Flat terrain.

    local ground = Instance.new("Part")

    ground.Name = "Ground"
    ground.Anchored = true

    ground.Size = Vector3.new(512, 2, 512)
    ground.Position = Vector3.new(0, -1, 0)

    ground.Material = Enum.Material.Grass
    ground.Color = Color3.fromRGB(111, 178, 102)

    ground.TopSurface = Enum.SurfaceType.Smooth
    ground.BottomSurface = Enum.SurfaceType.Smooth

    ground.Parent = folder

    -- World spawn.

    local spawn = Instance.new("SpawnLocation")

    spawn.Name = "WorldSpawn"

    spawn.Anchored = true
    spawn.Neutral = true

    spawn.AllowTeamChangeOnTouch = false

    spawn.Size = Vector3.new(12, 1, 12)
    spawn.Position = Vector3.new(0, 0.5, 0)

    spawn.Material = Enum.Material.SmoothPlastic
    spawn.Color = Color3.fromRGB(83, 145, 224)

    spawn.Parent = folder

    -- Lighting.

    Lighting.ClockTime = 14
    Lighting.Brightness = 2

    Lighting.Ambient = Color3.fromRGB(150, 150, 150)
    Lighting.OutdoorAmbient = Color3.fromRGB(185, 185, 185)

    workspace.FallenPartsDestroyHeight = -100

    -- Metadata accessible to server scripts.

    workspace:SetAttribute("WorldId", world.id)
    workspace:SetAttribute("WorldName", world.name)
    workspace:SetAttribute("WorldType", world.gameType)

    print("[Zeorinth] Generated flat world:", world.name)
end

--==============================================================
-- LOAD WORLD RECORD
--==============================================================

local function loadWorldForPlayer(player)
    local joinData = player:GetJoinData()
    local teleportData = joinData and joinData.TeleportData

    -- Studio preview mode.
    -- Normal published gameplay requires valid teleport data.

    if RunService:IsStudio() and not teleportData then
        return {
            id = "STUDIO_PREVIEW",
            name = "Studio Preview",

            ownerId = player.UserId,
            ownerName = player.Name,

            visibility = "Public",
            gameType = "Sandbox",

            maxPlayers = MAX_PLAYERS,
            collaborators = {},

            reservedServerId = ""
        }
    end

    if typeof(teleportData) ~= "table" then
        return nil, "Missing world information."
    end

    local worldId = teleportData.worldId

    if typeof(worldId) ~= "string"
        or #worldId < 30
        or #worldId > 40 then

        return nil, "Invalid world identifier."
    end

    local success, world = pcall(function()
        return WorldStore:GetAsync("World_" .. worldId)
    end)

    if not success then
        warn("[Zeorinth] DataStore error:", world)
        return nil, "Could not load your world."
    end

    if typeof(world) ~= "table" then
        return nil, "This world no longer exists."
    end

    if not canJoin(player, world) then
        return nil, "You do not have permission to access this world."
    end

    -- Verify that the current server belongs to this world.

    if not RunService:IsStudio() then
        if game.PrivateServerId ~= world.reservedServerId then
            return nil, "Invalid world server."
        end
    end

    return world
end

--==============================================================
-- PLAYER INITIALIZATION
--==============================================================

local function initializePlayer(player)
    local world, errorMessage = loadWorldForPlayer(player)

    if not world then
        player:Kick(
            "Zeorinth Sandbox\n" ..
            tostring(errorMessage or "Unable to load world.")
        )

        return
    end

    -- A reserved server should only host one world.

    if ActiveWorld and ActiveWorld.id ~= world.id then
        player:Kick("This server belongs to another world.")
        return
    end

    ActiveWorld = ActiveWorld or world

    -- Player capacity check.

    if #Players:GetPlayers() > world.maxPlayers then
        player:Kick("This world has reached its player limit.")
        return
    end

    -- Set player information.

    player:SetAttribute("WorldId", world.id)

    if world.ownerId == player.UserId then
        player:SetAttribute("WorldRole", "Owner")
    else
        player:SetAttribute("WorldRole", "Visitor")
    end

    -- Generate the environment once.

    generateWorld(ActiveWorld)

    -- Spawn the character after the environment exists.

    local success, err = pcall(function()
        player:LoadCharacterAsync()
    end)

    if not success then
        warn("[Zeorinth] Character loading failed:", err)
    end

    print(
        "[Zeorinth] Player loaded:",
        player.Name,
        "World:",
        world.name
    )
end

Players.PlayerAdded:Connect(function(player)
    task.spawn(initializePlayer, player)
end)

-- Handle players already in the server.

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(initializePlayer, player)
end

--==============================================================
-- PLAYER REMOVAL
--==============================================================

Players.PlayerRemoving:Connect(function(player)
    print(
        "[Zeorinth] Player left:",
        player.Name
    )
end)

print("======================================")
print("ZEORINTH SANDBOX GAMEPLAY BACKEND")
print("World loader initialized.")
print("======================================")
