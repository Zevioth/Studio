local SNAP = 4
local REACH = 120

local BLOCK_SIZE = Vector3.new(SNAP, SNAP, SNAP)

local ACTION_COOLDOWN = 0.08
local MAX_CAMERA_OFFSET = 64
local MAX_BLOCKS = 2000

