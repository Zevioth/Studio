local function notify(message)
    toastCounter += 1
    local thisCounter = toastCounter
    ToastText.Text = tostring(message or "")

    TweenService:Create(Toast, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 1, isMobile and -83 or -18),
    }):Play()

    task.delay(2.6, function()
        if toastCounter == thisCounter and Toast.Parent then
            TweenService:Create(Toast, TweenInfo.new(0.22), {
                Position = UDim2.new(0.5, 0, 1, 90),
            }):Play()
        end
    end)
end

--==============================================================
-- BACKEND CALL WRAPPER
--==============================================================

local function callBackend(action, ...)
    local args = table.pack(...)
    local success, result, apiError = pcall(function()
        return MenuAPI.Call(action, table.unpack(args, 1, args.n))
    end)

    if not success then
        warn("[Zeorinth] API error:", action, result)
        return nil, tostring(result)
    end

    if result == nil then
        return nil, apiError or "Backend request failed."
    end

    return result
end

