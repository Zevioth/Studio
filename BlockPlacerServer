        onlineText = tostring(world.currentPlayers or 0) .. "/" .. tostring(world.maxPlayers or 0) .. " players online"
    else
        onlineText = "Offline - starts when joined"
    end

    local details = makeText(
        card,
        tostring(world.gameType or "Sandbox") .. "  •  " .. tostring(world.ownerName or "Unknown") .. "  •  " .. onlineText,
