            local response, err = callBackend("JoinWorld", world.id)
            if not response then
                notify(err or "Could not contact backend.")
            elseif not response.ok then
                notify(response.message or "Could not join world.")
            end
        end)
    end)
    join.Position = UDim2.new(1, -108, 1, -42)
    join.TextSize = 10

    if showDelete then
        local delete = makeButton(card, "Delete", COLORS.Red, UDim2.fromOffset(76, 31), function()
            notify("Deleting world...")
            task.spawn(function()
                local response, err = callBackend("DeleteWorld", world.id)
                if not response then
                    notify(err or "Could not contact backend.")
                elseif not response.ok then
