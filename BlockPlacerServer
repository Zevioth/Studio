--// BLOCK FOLDER

local blockFolder = workspace:FindFirstChild(
    "BlockPlacerBlocks"
)

if not blockFolder then
    blockFolder = Instance.new("Folder")
    blockFolder.Name = "BlockPlacerBlocks"
    blockFolder.Parent = workspace
end

--// SERVER STATE

local blockGrid = {}
local playerCooldowns = {}

--==============================================================
-- GRID MATH
--==============================================================

local function snap1(value)
    return math.floor(value / SNAP + 0.5) * SNAP
end

local function gridKey(position)
    return
        math.floor(position.X / SNAP + 0.5)
        .. ","
        .. math.floor(position.Y / SNAP + 0.5)
        .. ","
        .. math.floor(position.Z / SNAP + 0.5)
end

local function getBlockAt(position)
    local key = gridKey(position)
    local block = blockGrid[key]

    if block and not block.Parent then
        blockGrid[key] = nil
        return nil
    end

    return block
end

local function registerBlock(block)
    local key = gridKey(block.Position)

    blockGrid[key] = block

    block.Destroying:Connect(function()
        if blockGrid[key] == block then
            blockGrid[key] = nil
        end
    end)
end

--==============================================================
-- TEXTURES
--==============================================================

local function addTextures(part)

    for face, textureId in pairs(FACE_TEXTURES) do

        local textureName =
            "BlockPlacerTexture_" .. FACE_NAMES[face]

        local texture = part:FindFirstChild(textureName)

        if not texture then
            texture = Instance.new("Texture")
            texture.Name = textureName
            texture.Parent = part
        end

        texture.Texture = textureId
        texture.Face = face

        texture.StudsPerTileU = 4
        texture.StudsPerTileV = 4
    end
end

-- Apply textures to the actual Tool Handle too.

local function styleTool(tool)

    if not tool:IsA("Tool") then return end
    if tool.Name ~= TOOL_NAME then return end

    local handle = tool:FindFirstChild("Handle")

    if handle and handle:IsA("BasePart") then

        handle.CanCollide = false
        handle.CanTouch = false
        handle.Massless = true

        addTextures(handle)
    end
end

local function watchContainer(container)

    for _, child in ipairs(container:GetChildren()) do
        styleTool(child)
    end

    container.ChildAdded:Connect(styleTool)
end

watchContainer(StarterPack)
StarterPack.ChildAdded:Connect(styleTool)

local function setupPlayer(player)

    player:SetAttribute("BlockPlacerLastAction", "None")

    local backpack = player:WaitForChild("Backpack")
    watchContainer(backpack)

    player.CharacterAdded:Connect(function(character)
        watchContainer(character)
    end)

    if player.Character then
        watchContainer(player.Character)
    end
end

Players.PlayerAdded:Connect(function(player)
    task.spawn(setupPlayer, player)
end)

for _, player in ipairs(Players:GetPlayers()) do
    task.spawn(setupPlayer, player)
end

--==============================================================
-- SOUND SYSTEM
--==============================================================

local function playRandomAt(position, soundIds)

    if #soundIds == 0 then return end

    local emitter = Instance.new("Part")

    emitter.Name = "BlockPlacerSoundEmitter"
    emitter.Size = Vector3.new(0.2, 0.2, 0.2)

    emitter.Anchored = true
    emitter.CanCollide = false
    emitter.CanTouch = false
    emitter.CanQuery = false

    emitter.Transparency = 1
    emitter.Position = position
    emitter.Parent = workspace

    local sound = Instance.new("Sound")

    sound.SoundId = soundIds[
        math.random(1, #soundIds)
    ]

    sound.Volume = 1
    sound.RollOffMaxDistance = 70
    sound.Parent = emitter

    sound:Play()

    Debris:AddItem(emitter, 4)
end

--==============================================================
-- PLACEMENT CALCULATION
--==============================================================

local function calcPlacementCenter(result)

    local normal = result.Normal
    local hit = result.Position

    local nx = normal.X
    local ny = normal.Y
    local nz = normal.Z

    local absX = math.abs(nx)
    local absY = math.abs(ny)
    local absZ = math.abs(nz)

    local hitBlock = result.Instance

    local isOwnedBlock =
        hitBlock:IsA("BasePart")
        and hitBlock:GetAttribute("BlockPlacerOwned") == true

    -- HORIZONTAL SURFACE

    if absY >= absX and absY >= absZ then

        local cx
        local cz

        if isOwnedBlock then

            local ap = hitBlock.Position

            cx = ap.X
                + math.floor((hit.X - ap.X) / SNAP + 0.5)
                * SNAP

            cz = ap.Z
                + math.floor((hit.Z - ap.Z) / SNAP + 0.5)
                * SNAP

        else

            cx = snap1(hit.X)
            cz = snap1(hit.Z)

        end

        local cy = hit.Y + ny * SNAP * 0.5

        return Vector3.new(cx, cy, cz)

    end

    -- SIDE SURFACE

    if isOwnedBlock then

        local ap = hitBlock.Position

        return Vector3.new(
            ap.X + math.round(nx) * SNAP,
            ap.Y + math.round(ny) * SNAP,
            ap.Z + math.round(nz) * SNAP
        )

    else

        if absX >= absZ then

            return Vector3.new(
                hit.X + nx * SNAP * 0.5,
                snap1(hit.Y),
                snap1(hit.Z)
            )

        else

            return Vector3.new(
                snap1(hit.X),
                snap1(hit.Y),
                hit.Z + nz * SNAP * 0.5
            )

        end
    end
end

--==============================================================
-- PLAYER OVERLAP CHECK
--==============================================================

local function overlapsPlayer(center, character)

    if not character then return false end

    local half = SNAP * 0.5

    for _, part in ipairs(character:GetDescendants()) do

        if part:IsA("BasePart") then

            local difference = part.Position - center

            if math.abs(difference.X) < part.Size.X * 0.5 + half
            and math.abs(difference.Y) < part.Size.Y * 0.5 + half
            and math.abs(difference.Z) < part.Size.Z * 0.5 + half then

                return true
            end
        end
    end

    return false
end

--==============================================================
-- BREAK PARTICLES
--==============================================================

local PARTICLE_COUNT = 10

local function randomBetween(minimum, maximum)
    return minimum + math.random() * (maximum - minimum)
end

local function spawnBreakParticles(block)

    local origin = block.Position

    for _ = 1, PARTICLE_COUNT do

        local size = randomBetween(0.22, 0.55)
        local thickness = size * randomBetween(0.25, 0.55)

        local particle = Instance.new("Part")

        local axis = math.random(1, 3)

        if axis == 1 then
            particle.Size = Vector3.new(
                thickness, size, size
            )
        elseif axis == 2 then
            particle.Size = Vector3.new(
                size, thickness, size
            )
        else
            particle.Size = Vector3.new(
                size, size, thickness
            )
        end

        particle.Anchored = false
        particle.CanCollide = false
        particle.CanTouch = false
        particle.CanQuery = false
        particle.CastShadow = false

        particle.Material = Enum.Material.SmoothPlastic
        particle.Color = block.Color

        local half = SNAP * 0.5

        particle.CFrame =
            CFrame.new(
                origin.X + randomBetween(-half, half),
                origin.Y + randomBetween(-half, half),
                origin.Z + randomBetween(-half, half)
            )
            * CFrame.Angles(
                math.random() * math.pi * 2,
                math.random() * math.pi * 2,
                math.random() * math.pi * 2
            )

        local textureId = FACE_TEXTURE_LIST[
            math.random(1, #FACE_TEXTURE_LIST)
        ]

        for _, face in ipairs(Enum.NormalId:GetEnumItems()) do

            local texture = Instance.new("Texture")

            texture.Texture = textureId
            texture.Face = face

            texture.StudsPerTileU = 2
            texture.StudsPerTileV = 2

            texture.Parent = particle
        end

        particle.Parent = workspace

        particle.AssemblyLinearVelocity = Vector3.new(
            randomBetween(-1, 1) * randomBetween(8, 20),
            randomBetween(5, 15),
            randomBetween(-1, 1) * randomBetween(8, 20)
        )

        particle.AssemblyAngularVelocity = Vector3.new(
            randomBetween(-12, 12),
            randomBetween(-12, 12),
            randomBetween(-12, 12)
        )

        Debris:AddItem(particle, 1.2)
    end
end

--==============================================================
-- BLOCK CREATION
--==============================================================

local function spawnBlock(player, result, character)

    if not result then return false end

    if #blockFolder:GetChildren() >= MAX_BLOCKS then
        return false
    end

    local center = calcPlacementCenter(result)

    -- Prevent duplicate grid positions.

    if getBlockAt(center) then
        return false
    end

    -- Prevent placement inside the player.

    if overlapsPlayer(center, character) then
        return false
    end

    local block = Instance.new("Part")

    block.Name = "ClientBlock"
    block.Size = BLOCK_SIZE

    block.Anchored = true
    block.CanCollide = true
    block.CanTouch = true
    block.CanQuery = true

    block.Material = Enum.Material.SmoothPlastic
    block.BrickColor = BrickColor.new("Bright green")

    block.CFrame = CFrame.new(center)

    block:SetAttribute("BlockPlacerOwned", true)
    block:SetAttribute("OwnerUserId", player.UserId)

    -- Create immediately on the SERVER.

    block.Parent = blockFolder

    addTextures(block)

    -- FIX M: Grass Type tag.

    local typeValue = Instance.new("StringValue")

    typeValue.Name = "Type"
    typeValue.Value = "Grass"
    typeValue.Parent = block

    registerBlock(block)

    playRandomAt(center, PLACE_SOUND_IDS)

    player:SetAttribute("BlockPlacerLastAction", "Place")

    -- Spawn animation.

    block.Size = BLOCK_SIZE * 0.55

    local growTween = TweenService:Create(
        block,
        TweenInfo.new(
            0.13,
            Enum.EasingStyle.Back,
            Enum.EasingDirection.Out
        ),
        {
            Size = BLOCK_SIZE * 1.08
        }
    )

    growTween:Play()

    growTween.Completed:Connect(function()

        if not block or not block.Parent then
            return
        end

        local settleTween = TweenService:Create(
            block,
            TweenInfo.new(0.07),
            {
                Size = BLOCK_SIZE
            }
        )

        settleTween:Play()
    end)

    remote:FireClient(player, "Success", "Place")

    return true
end

--==============================================================
-- BLOCK DELETION
--==============================================================

local function deleteBlock(player, result)

    if not result or not result.Instance then
        return false
    end

    local target = result.Instance

    -- Only delete blocks created by this system.

    if not target:IsA("BasePart") then
        return false
    end

    if target:GetAttribute("BlockPlacerOwned") ~= true then
        return false
    end

    if not target:IsDescendantOf(blockFolder) then
        return false
    end

    local position = target.Position

    playRandomAt(position, DELETE_SOUND_IDS)

    spawnBreakParticles(target)

    player:SetAttribute("BlockPlacerLastAction", "Break")

    local breakTween = TweenService:Create(
        target,
        TweenInfo.new(
            0.06,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.In
        ),
        {
            Size = BLOCK_SIZE * 0.05,
            Transparency = 0.8
        }
    )

    breakTween:Play()

    breakTween.Completed:Connect(function()

        if target and target.Parent then
            target:Destroy()
        end
    end)

    remote:FireClient(player, "Success", "Break")

    return true
end

--==============================================================
-- SERVER RAYCAST
--==============================================================

local function getServerRaycast(player, origin, direction)

    local character = player.Character

    if not character then return nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")

    if not humanoid or humanoid.Health <= 0 then
        return nil
    end

    if not head then return nil end

    if typeof(origin) ~= "Vector3"
    or typeof(direction) ~= "Vector3" then
        return nil
    end

    local directionMagnitude = direction.Magnitude

    if directionMagnitude < 0.5
    or directionMagnitude > 1.5 then
        return nil
    end

    -- Limit how far the supplied camera origin can be
    -- from the player's actual character.

    if (origin - head.Position).Magnitude > MAX_CAMERA_OFFSET then
        return nil
    end

    local params = RaycastParams.new()

    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { character }
    params.IgnoreWater = true

    local unitDirection = direction.Unit

    local result = workspace:Raycast(
        origin,
        unitDirection * REACH,
        params
    )

    -- The actual hit must also be within player reach.

    if result then
        if (result.Position - head.Position).Magnitude > REACH then
            return nil
        end
    end

    return result
end

--==============================================================
-- REMOTE EVENT VALIDATION
--==============================================================

remote.OnServerEvent:Connect(function(
    player,
    action,
    origin,
    direction
)

    if action ~= "Place" and action ~= "Break" then
        return
    end

    local character = player.Character

    if not character then return end

    -- Tool MUST actually be equipped on the server.

    local equippedTool = character:FindFirstChild(TOOL_NAME)

    if not equippedTool or not equippedTool:IsA("Tool") then
        return
    end

    local handle = equippedTool:FindFirstChild("Handle")

    if not handle or not handle:IsA("BasePart") then
        return
    end

    -- Server cooldown.

    local now = os.clock()

    if not playerCooldowns[player] then
        playerCooldowns[player] = {
            Place = 0,
            Break = 0
        }
    end

    local cooldowns = playerCooldowns[player]

    if now - cooldowns[action] < ACTION_COOLDOWN then
        return
    end

    cooldowns[action] = now

    -- Server performs the actual raycast.

    local result = getServerRaycast(
        player,
        origin,
        direction
    )

    if not result then
        return
    end

    if action == "Place" then

        spawnBlock(player, result, character)

    elseif action == "Break" then

        deleteBlock(player, result)

    end
end)

--==============================================================
-- PLAYER CLEANUP
--==============================================================

Players.PlayerRemoving:Connect(function(player)

    playerCooldowns[player] = nil

end)

